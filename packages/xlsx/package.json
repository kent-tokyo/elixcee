{
  "name": "@elixcee/xlsx",
  "version": "0.1.0-phase1a",
  "private": true,
  "description": "Drop-in replacement for xlsx (SheetJS) — Phase 1A: pure address/workbook utility API only, no file I/O yet. See ../../docs/xlsx-architecture.md.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.cjs",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.cjs"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
