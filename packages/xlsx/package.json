{
  "name": "@elixcee/xlsx",
  "version": "0.0.0-development",
  "private": true,
  "description": "In-progress drop-in-compatible reimplementation of xlsx (SheetJS): all utils.* exports and XLSX.read() are implemented and differential-tested against the real package; write()/writeFile()/readFile() are not implemented yet. See README.md.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.cjs",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "browser": "./src/index.browser.mjs",
      "import": "./src/index.mjs",
      "require": "./src/index.cjs"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:no-dom": "tsc --noEmit -p tsconfig.no-dom.json"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ssf": "0.11.2"
  }
}
