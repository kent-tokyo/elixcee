{
  "name": "@elixcee/xlsx",
  "version": "0.0.0-development",
  "private": true,
  "description": "Drop-in-compatible reimplementation of xlsx (SheetJS) with bounded XLSX/XLSM read-write, formula calculation, and opaque VBA-project preservation. See README.md for exact scope.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.cjs",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "browser": "./src/index.browser.mjs",
      "import": "./src/index.mjs",
      "require": "./src/index.cjs"
    },
    "./runtime": {
      "types": "./src/runtime.d.ts",
      "browser": "./src/runtime.browser.mjs",
      "import": "./src/runtime.mjs",
      "require": "./src/runtime.cjs"
    }
  },
  "browser": {
    "./src/internal/wasm/elixcee_wasm.node.cjs": false,
    "./src/internal/deflate-node.cjs": false,
    "fs": false,
    "zlib": false
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:no-dom": "tsc --noEmit -p tsconfig.no-dom.json",
    "audit:pack": "node scripts/audit-pack-contents.mjs",
    "wasm:smoke": "node scripts/wasm-smoke.mjs",
    "chart:smoke": "node test/chart-roundtrip.mjs",
    "formula:spill": "node test/formula-spill.mjs",
    "xlsm:smoke": "node test/xlsm-roundtrip.mjs",
    "xlsm:reopen:smoke": "node test/xlsm-reopen-smoke.mjs",
    "comment:smoke": "node test/comment-roundtrip.mjs",
    "style:smoke": "node test/style-roundtrip.mjs",
    "conditional:smoke": "node test/conditional-format-roundtrip.mjs",
    "freeze:smoke": "node test/freeze-pane-roundtrip.mjs",
    "zip:smoke": "node ../../playground/test/zip-budget.test.mjs",
    "pack:consumer": "node scripts/pack-consumer-smoke.mjs",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "playground:a11y": "node ../../playground/test/accessibility-smoke.mjs",
    "playground:interaction": "node ../../playground/test/interaction-smoke.mjs",
    "playground:pivot": "node ../../playground/test/pivot-summary.test.mjs",
    "pivot:smoke": "node test/pivot-roundtrip.mjs",
    "playground:large-sparse": "PLAYGROUND_PROFILE=large-sparse node ../../playground/test/accessibility-smoke.mjs",
    "playground:scroll-soak": "PLAYGROUND_PROFILE=scroll-soak node ../../playground/test/accessibility-smoke.mjs",
    "playground:mobile": "PLAYGROUND_VIEWPORT=mobile node ../../playground/test/accessibility-smoke.mjs",
    "playground:vba": "node ../../playground/test/vba-worker.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28",
    "typescript": "^5"
  },
  "dependencies": {
    "ssf": "0.11.2"
  }
}
