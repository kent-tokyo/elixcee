{
  "name": "@elixcee/xlsx",
  "version": "0.0.0-development",
  "private": true,
  "description": "Drop-in-compatible reimplementation of xlsx (SheetJS): all utils.* exports, read()/readFile()/readFileSync(), and write()/writeFile()/writeFileSync() (bookType xlsx) are implemented and differential-tested against the real package. See README.md for exact scope.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.cjs",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "browser": "./src/index.browser.mjs",
      "import": "./src/index.mjs",
      "require": "./src/index.cjs"
    }
  },
  "browser": {
    "./src/internal/wasm/elixcee_wasm.node.cjs": false,
    "fs": false
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:no-dom": "tsc --noEmit -p tsconfig.no-dom.json",
    "audit:pack": "node scripts/audit-pack-contents.mjs",
    "wasm:smoke": "node scripts/wasm-smoke.mjs",
    "pack:consumer": "node scripts/pack-consumer-smoke.mjs",
    "browser:smoke": "node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28",
    "typescript": "^5"
  },
  "dependencies": {
    "ssf": "0.11.2"
  }
}
