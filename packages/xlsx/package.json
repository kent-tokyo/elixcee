{
  "name": "@elixcee/xlsx",
  "version": "0.0.0-development",
  "private": true,
  "description": "Drop-in replacement for xlsx (SheetJS) — Phase 2B: minimal buffer-first read() backed by a WASM bridge over elixcee's own reader, plus the full utils surface (aliases/constants, HTML export, DOM table conversion) from earlier phases. See ../../docs/xlsx-architecture.md.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.cjs",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "browser": "./src/index.browser.mjs",
      "import": "./src/index.mjs",
      "require": "./src/index.cjs"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:no-dom": "tsc --noEmit -p tsconfig.no-dom.json"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ssf": "0.11.2"
  }
}
