    {"name":"SORTBY","argument_shape":"array, by_array1, sort_order1 [, by_array2, sort_order2, ...]","supported_modes":{"sort_order":[1,-1]},"unsupported_modes":["incompatible multi-key shapes"],"oracle_status":"unverified","tests":["test_spill_sort"]},
    {"name":"TAKE","argument_shape":"array, rows [, columns]","supported_modes":{"rows":["nonzero integer"],"columns":["nonzero integer"]},"unsupported_modes":["zero rows or columns"],"oracle_status":"unverified","tests":["test_take_drop"]},
    {"name":"DROP","argument_shape":"array, rows [, columns]","supported_modes":{"rows":["nonzero integer"],"columns":["nonzero integer"]},"unsupported_modes":["zero rows or columns"],"oracle_status":"unverified","tests":["test_take_drop"]},
    {"name":"FORECAST.ETS.CONFINT","argument_shape":"target_date, values, timeline [, confidence_level [, seasonality [, data_completion [, aggregation]]]]","supported_modes":{"seasonality":["0 or bounded positive integer"],"confidence_level":["0 < level < 1"]},"unsupported_modes":["Excel AAA ETS parity","missing-value completion","duplicate-timeline aggregation"],"oracle_status":"unverified","tests":["test_statistical_extended"]},
    {"name":"FORECAST.ETS.STAT","argument_shape":"values, timeline, statistic_type [, seasonality [, data_completion [, aggregation]]]","supported_modes":{"statistic_type":[1,2,3,4,5,6,7,8],"seasonality":["0 or bounded positive integer"]},"unsupported_modes":["Excel AAA ETS parameter estimation parity","missing-value completion","duplicate-timeline aggregation"],"oracle_status":"unverified","tests":["test_statistical_extended"]}
