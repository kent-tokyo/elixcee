  "functions": [
    {"name":"XLOOKUP","argument_shape":"lookup_value, lookup_array, return_array [, if_not_found [, match_mode [, search_mode]]]","supported_modes":{"match_mode":[0,-1,1,2],"search_mode":[1,-1,2,-2]},"unsupported_modes":["wildcard match combined with binary search"],"oracle_status":"unverified","tests":["test_xlookup_wildcard_and_binary_search_modes"]},
    {"name":"XMATCH","argument_shape":"lookup_value, lookup_array [, match_mode [, search_mode]]","supported_modes":{"match_mode":[0,-1,1,2],"search_mode":[1,-1,2,-2]},"unsupported_modes":["wildcard match combined with binary search"],"oracle_status":"unverified","tests":["test_lookup_xmatch"]},
    {"name":"INDEX","argument_shape":"array, row_num [, column_num]","supported_modes":{"row_num":[0],"column_num":[0]},"unsupported_modes":["reference-form and area_num overloads"],"oracle_status":"unverified","tests":["test_index"]},
    {"name":"MATCH","argument_shape":"lookup_value, lookup_array [, match_type]","supported_modes":{"match_type":[-1,0,1]},"unsupported_modes":["non-sorted approximate lookup inputs are not normalized"],"oracle_status":"unverified","tests":["test_match_exact"]},
