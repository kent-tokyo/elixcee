{
  "name": "elixcee-compat-harness",
  "private": true,
  "version": "0.0.0",
  "description": "Node-side oracle + differential-testing harness for the @elixcee/xlsx compatibility initiative. Not published.",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "oracle:manifest": "node oracle/generate-manifest.mjs",
    "differential:demo": "node differential/run-demo.mjs",
    "differential:utils": "node differential/xlsx-utils.test.mjs",
    "differential:read": "node differential/xlsx-read.test.mjs",
    "differential:metadata": "node differential/metadata.test.mjs",
    "differential:ssf-format": "node differential/ssf-format.test.mjs",
    "classifier:self-check": "node differential/classify.mjs && node differential/normalize.mjs",
    "corpus:run": "node corpus/run-elixcee.mjs",
    "corpus:outcomes": "node corpus/classify-elixcee-outcomes.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "xlsx": "0.18.5"
  }
}
